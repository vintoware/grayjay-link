[Unit]
Description=Grayjay Link (keeps a sync session with Grayjay Desktop and opens links in it)
Documentation=https://github.com/vintoware/grayjay-link
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/.local/bin/grayjay-link daemon
Restart=on-failure
RestartSec=3
# Only stop the daemon itself, never a Grayjay it launched.
KillMode=process

[Install]
WantedBy=graphical-session.target
